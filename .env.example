# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env TIDAK ikut ter-commit (lihat .gitignore).

# Kunci sesi Flask. Wajib diisi saat deploy publik.
# Buat nilai acak, contoh: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port server lokal (default: 5000)
PORT=5000

# Mode debug Flask: true / false (default: false)
DEBUG=false
